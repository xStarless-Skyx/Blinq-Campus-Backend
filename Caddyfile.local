{
	# Local HTTPS certificates issued by Caddy's internal CA.
	local_certs
	# Avoid binding privileged port 80 for redirect handling in local dev.
	auto_https disable_redirects
}

https://local.blinqcampus.chat:24701 {
	bind 127.0.0.1
	reverse_proxy [::1]:14701
}

